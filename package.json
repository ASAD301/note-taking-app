{
  "name": "note-taking-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "migrate": "bun run scripts/migrate.ts",
    "auth:generate": "bun --bun x auth@latest generate --config lib/auth.ts",
    "backup": "bun run scripts/backup.ts",
    "test": "bun test tests/unit",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-code-block-lowlight": "^3.35.0",
    "@tiptap/extensions": "3.35.0",
    "@tiptap/html": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "better-auth": "^1.7.28",
    "happy-dom": "^21.0.4",
    "lowlight": "^3.3.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.4.5",
    "@types/hast": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
